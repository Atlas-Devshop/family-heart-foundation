    <decisions>
        <name>Check_Geocode_Just_Populated</name>
        <label>Geocode Just Populated?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No - Already Had Coordinates</defaultConnectorLabel>
        <rules>
            <name>Geocode_Just_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmGeocodeJustPopulated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Call_Household_Geo_Match</targetReference>
            </connector>
            <label>Yes - Geocoding just completed</label>
        </rules>
    </decisions>
    <description>Fires after Contact geocode is populated. Calls HouseholdGeoMatchInvocable to match the contact to an existing nearby household or keep the NPSP auto-created one.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmGeocodeJustPopulated</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISNULL({!$Record__Prior.Id}),
    ISNULL({!$Record__Prior.MailingLatitude}),
    {!$Record.MailingLatitude} &lt;&gt; {!$Record__Prior.MailingLatitude},
    {!$Record.MailingStreet} &lt;&gt; {!$Record__Prior.MailingStreet},
    {!$Record.MailingCity} &lt;&gt; {!$Record__Prior.MailingCity},
    {!$Record.MailingState} &lt;&gt; {!$Record__Prior.MailingState},
    {!$Record.MailingPostalCode} &lt;&gt; {!$Record__Prior.MailingPostalCode},
    {!$Record.MailingCountry} &lt;&gt; {!$Record__Prior.MailingCountry}
)</expression>
    </formulas>
    <interviewLabel>Contact After Save/Update - Household Geo Match {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact After Save/Update - Household Geo Match</label>
