                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Email_Config.Is_Enabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Auto_Reply_Email</targetReference>
            </connector>
            <label>Should Send</label>
        </rules>
    </decisions>
    <description>Created by Atlas Devshop ( Anas Saidi ): this flow is used to send auto reply email with scheduling link after intake is created for Care Navigation record type.</description>
