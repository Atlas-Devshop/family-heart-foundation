    <textTemplates>
        <name>emailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
  &lt;meta charset=&quot;UTF-8&quot;&gt;
  &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
  &lt;title&gt;Email Template&lt;/title&gt;
  &lt;style&gt;
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333333;
      margin: 0;
      padding: 0;
      background-color: #f9f9f9;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 20px;
      border-radius: 6px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }
    .btn {
      display: inline-block;
      padding: 12px 20px;
      margin: 20px 0;
      font-size: 16px;
      color: #ffffff;
      background-color: #0073e6;
      text-decoration: none;
      border-radius: 4px;
    }
    .footer {
      font-size: 12px;
      color: #777777;
      margin-top: 30px;
    }
    a {
      color: #0073e6;
      text-decoration: none;
    }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;div class=&quot;email-container&quot;&gt;
    &lt;p&gt;Hello {!Get_Intake.First_Name__c},&lt;/p&gt;

    &lt;p&gt;We&apos;re following up to make sure you received our previous email inviting you to connect with our Family Heart Foundation Care Navigation Center.&lt;/p&gt;

    &lt;p&gt;If you do not already have a meeting scheduled, you can &lt;strong&gt;&lt;a href=&quot;https://calendly.com/d/crwp-pk7-zjz/family-heart-care-navigation-meeting&quot;&gt;click HERE&lt;/a&gt; to schedule a virtual meeting&lt;/strong&gt; at a time that works for you — all at no cost!&lt;/p&gt;

    &lt;p&gt;Please let us know if you have any questions or issues using the link to schedule with us. We look forward to hearing from you soon.&lt;/p&gt;

    &lt;div class=&quot;footer&quot;&gt;
      &lt;p&gt;Best,&lt;br&gt;The Family Heart Team&lt;/p&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/body&gt;
&lt;/html&gt;</text>
