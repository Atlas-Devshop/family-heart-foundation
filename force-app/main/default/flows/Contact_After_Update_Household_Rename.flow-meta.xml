        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>HouseholdRenameInvocable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>householdId</name>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>newLastName</name>
            <value>
                <elementReference>$Record.LastName</elementReference>
            </value>
        </inputParameters>
        <nameSegment>HouseholdRenameInvocable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Rename_New_Household</name>
        <label>Rename New Household</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>HouseholdRenameInvocable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>householdId</name>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>newLastName</name>
            <value>
                <elementReference>$Record.LastName</elementReference>
            </value>
        </inputParameters>
        <nameSegment>HouseholdRenameInvocable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Rename_Old_Household</name>
        <label>Rename Old Household</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>HouseholdRenameInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Has_New_Household</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>householdId</name>
            <value>
                <elementReference>$Record__Prior.AccountId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>HouseholdRenameInvocable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_New_Household</name>
        <label>Has New Household?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No - End</defaultConnectorLabel>
        <rules>
            <name>New_Household_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmHasNewHousehold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rename_New_Household</targetReference>
            </connector>
            <label>Yes - Rename New Household</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_Changed</name>
        <label>What Changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Nothing Relevant - End</defaultConnectorLabel>
        <rules>
            <name>Last_Name_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmLastNameChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>frmAccountChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>frmHasNewHousehold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rename_Current_Household</targetReference>
            </connector>
            <label>Last Name Changed</label>
        </rules>
        <rules>
            <name>Household_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmAccountChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>frmHadPriorHousehold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rename_Old_Household</targetReference>
            </connector>
            <label>Household Changed</label>
        </rules>
    </decisions>
    <description>Renames the affected household(s) when a Contact last name changes or when a Contact is moved between households.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmAccountChanged</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.AccountId} &lt;&gt; {!$Record__Prior.AccountId}</expression>
    </formulas>
    <formulas>
        <name>frmHadPriorHousehold</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNULL({!$Record__Prior.AccountId}))</expression>
    </formulas>
    <formulas>
        <name>frmHasNewHousehold</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNULL({!$Record.AccountId}))</expression>
    </formulas>
    <formulas>
        <name>frmLastNameChanged</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.LastName} &lt;&gt; {!$Record__Prior.LastName}</expression>
    </formulas>
    <interviewLabel>Contact After Update - Household Rename {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact After Update - Household Rename</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>What_Changed</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
